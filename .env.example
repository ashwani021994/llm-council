# Copy this file to .env. Never paste this key into the question box.
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional: comma-separated OpenRouter model IDs (2 to 6 distinct models).
# Reasoning effort is low for reasoning models; non-reasoning models work too.
# Use "Check model IDs (no generation)" in the UI to validate your selection.
# COUNCIL_MODELS=openai/gpt-4.1-mini,openai/gpt-4.1-nano
# CHAIRMAN_MODEL=openai/gpt-4.1-mini

# Output cap per model call, including reasoning where the provider counts it.
# Allowed range: 128 to 4096. This is not a dollar spending limit.
MAX_OUTPUT_TOKENS=1024
LOCAL_PORT=7860

# Optional: minimum 16 characters. Otherwise, a new random password is printed
# at each startup. Username is always council. Keep this different from the API key.
# LOCAL_APP_PASSWORD=choose-a-long-unique-password
